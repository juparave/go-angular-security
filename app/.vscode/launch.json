{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  //
  // "app"          → local Fiber backend (localhost:5000, 10.0.2.2:5000 on Android)
  // "Remote debug" → shared staging host
  // profile/release → production host
  // See lib/core/config/environment_config.dart for the precedence rules.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=development=true"
      ]
    },
    {
      "name": "Remote debug",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=remoteDebug=true"
      ]
    },
    {
      "name": "app (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "app (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
