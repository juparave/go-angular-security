# ============================================
# Application Configuration
# ============================================
APP_NAME=GO-ANGULAR-SECURITY
APP_MODE=development
APP_PORT=5000
APP_DOMAIN=http://localhost:4200
UPLOADS_PATH=./uploads

# ============================================
# Database Configuration (SQLite)
# ============================================
DATABASE_DRIVER=sqlite
DATABASE_PATH=data/gorm.db

# ============================================
# JWT Configuration
# ============================================
# Secret for access tokens — use a long random string in production
JWT_SECRET=your-jwt-secret-key-change-in-production
# Secret for refresh tokens — must differ from JWT_SECRET
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Secret for password reset tokens
JWT_RESET_SECRET=your-reset-secret-key-change-in-production
# Access token TTL in hours (default: 24 = 1 day)
JWT_ACCESS_TOKEN_TTL=24
# Refresh token TTL in hours (default: 720 = 30 days)
JWT_REFRESH_TOKEN_TTL=720

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_ACCOUNT=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_CONTACT_FROM=noreply@example.com
EMAIL_CONTACT_TO=support@example.com

# Dev mode: redirect all outgoing emails to a test address
# EMAIL_DEV_MODE=true
# EMAIL_TEST_RECIPIENT=dev@example.com

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Stripe callback URLs (defaults to APP_DOMAIN if not set)
# STRIPE_SUCCESS_URL=http://localhost:4200/subscription/success
# STRIPE_CANCEL_URL=http://localhost:4200/subscription/cancel

# ============================================
# Google OAuth
# ============================================
# Client ID from Google Cloud Console (used by the Angular frontend)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# Multitenancy Configuration
# ============================================
# Path where tenant databases are stored
TENANT_DATA_PATH=./data
