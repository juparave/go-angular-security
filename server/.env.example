# ============================================
# Application Configuration
# ============================================
APP_NAME=GO-ANGULAR-SECURITY
APP_MODE=development
APP_PORT=5000
APP_DOMAIN=http://localhost:4200
UPLOADS_PATH=./uploads

# ============================================
# Database Configuration (SQLite)
# ============================================
DATABASE_DRIVER=sqlite
DATABASE_PATH=gorm.db

# ============================================
# JWT Configuration
# ============================================
# Secret for access tokens (change in production!)
JWT_SECRET=your-jwt-secret-key-change-in-production
# Secret for refresh tokens (should be different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Secret for password reset tokens
JWT_RESET_SECRET=your-reset-secret-key-change-in-production
# Access token TTL in hours (default: 2160 = 90 days)
JWT_ACCESS_TOKEN_TTL=2160
# Refresh token TTL in hours (default: 4320 = 180 days)
JWT_REFRESH_TOKEN_TTL=4320

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_ACCOUNT=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_CONTACT_FROM=noreply@example.com
EMAIL_CONTACT_TO=support@example.com

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# Multitenancy Configuration
# ============================================
# Path where tenant databases are stored
TENANT_DATA_PATH=./data
